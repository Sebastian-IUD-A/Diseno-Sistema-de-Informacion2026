# Copie este archivo como ".env" (en la misma carpeta que docker-compose.yml) para cambiar valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Base de datos ---
DB_USER=autos
DB_PASSWORD=autos_dev
DB_ROOT_PASSWORD=root_dev

# --- Seguridad ---
# Secreto para firmar los tokens JWT. Mínimo 32 caracteres. Si se deja vacío, el backend
# genera uno temporal en cada arranque (las sesiones se cierran al reiniciar el backend).
# Para generar uno:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=480

# --- Puertos en su computador (cámbielos si ya están ocupados) ---
FRONTEND_PUERTO_HOST=3000
BACKEND_PUERTO_HOST=8080
DB_PUERTO_HOST=3307
